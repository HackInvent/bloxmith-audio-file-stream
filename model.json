{
  "kind": "audio_file_stream",
  "version": "0.1.0",
  "title": "Audio File Stream",
  "description": "Stream completed local WAV and Ogg/Opus files as paced audio, with explicit lifecycle and interruption commands.",
  "repository_url": "https://github.com/HackInvent/bloxmith-audio-file-stream",
  "bloxsmith_compatibility": ["1.0.9"],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "executable",
      "name": "ffmpeg"
    },
    {
      "type": "manual",
      "name": "Linux, Python 3.12, FFmpeg with the libopus encoder; an explicit local source directory."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "file_in",
        "title": "Audio file",
        "accepts": [
          "file/path",
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "message"
      },
      {
        "id": 2,
        "name": "command_in",
        "title": "Interrupt",
        "accepts": [
          "application/json"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "message"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "audio_out",
        "title": "Audio out",
        "emits": [
          "audio/*"
        ],
        "multiplicity": "many",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": [
            "opus"
          ],
          "sample_rates_hz": [
            48000
          ],
          "channels": [
            1,
            2
          ]
        }
      },
      {
        "id": 2,
        "name": "command_out",
        "title": "Stream cycle",
        "emits": [
          "application/json"
        ],
        "multiplicity": "many",
        "transport": "message"
      },
      {
        "id": 3,
        "name": "status",
        "title": "Status",
        "emits": [
          "application/json"
        ],
        "multiplicity": "many",
        "transport": "message"
      }
    ]
  },
  "config": {
    "allowed_root": "",
    "max_input_mib": 32,
    "max_audio_sec": 120,
    "prepare_timeout_sec": 30,
    "queue_size": 4,
    "bitrate_kbps": 96
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event",
    "supports_runtime_audio_streams": true,
    "file_browser": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
